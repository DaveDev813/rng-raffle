{
  "name": "rng-raffle",
  "version": "0.0.1",
  "description": "RNG Raffle",
  "productName": "RNG Raffle",
  "author": "Rodave Joseph Bobadilla <rodave.developer@gmail.com>",
  "private": true,
  "type": "module",
  "quasarCli": {
    "quasarConfEnv": {
      "folder": "..",
      "file": [
        ".env.frontend"
      ],
      "prefix": "QUASAR_"
    }
  },
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "postinstall": "quasar prepare",
    "dev": "quasar dev",
    "build": "quasar build",
    "start": "quasar dev -m pwa",
    "buildpwa": "quasar build -m pwa",
    "generate:pwa-icons": "npm exec --yes --package @quasar/icongenie@4.0.0 -- icongenie generate -m pwa -i src-pwa/icon.png && rm -rf public/pwa-icons && mv public/icons public/pwa-icons",
    "postman-test": "npm exec --yes --package newman@6.2.2 -- newman run ../postman/API.postman_collection.json --environment ../postman/LOCAL_ENV.postman_environment.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.4",
    "@ionic/pwa-elements": "^3.4.0",
    "@quasar/extras": "^2.0.2",
    "axios": "^1.16.1",
    "dayjs": "^1.11.20",
    "echarts": "^6.1.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.13.0",
    "jszip": "^3.10.1",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "pdfjs-dist": "^5.7.284",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "quasar": "^2.19.3",
    "signature_pad": "^5.1.3",
    "vue": "^3.5.34",
    "vue-echarts": "^8.3.0",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.0.7",
    "vuedraggable": "^4.1.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@quasar/app-vite": "^3.0.1",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@types/node": "^24.12.4",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vue/language-plugin-pug": "^3.3.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vite-plugin-checker": "^0.13.0",
    "vite-plugin-pug": "^0.4.1",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.1"
  },
  "engines": {
    "node": "^24",
    "npm": ">= 11"
  }
}
